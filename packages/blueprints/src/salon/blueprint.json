{
  "id": "salon",
  "version": 1,
  "name": "Salon booking",
  "description": "Service booking with staff choice for salons, spas and barbershops.",
  "defaultLanguage": "en",
  "languages": ["en", "ar"],
  "offeringType": "service",
  "fulfillmentTypes": ["in_store"],
  "orderStates": {
    "initial": "requested",
    "states": ["requested", "confirmed", "checked_in", "in_progress", "completed", "cancelled", "rejected", "no_show"],
    "transitions": [
      { "from": "requested", "to": "confirmed", "on": "confirm" },
      { "from": "requested", "to": "rejected", "on": "reject" },
      { "from": "requested", "to": "cancelled", "on": "cancel" },
      { "from": "confirmed", "to": "checked_in", "on": "check_in" },
      { "from": "confirmed", "to": "cancelled", "on": "cancel" },
      { "from": "confirmed", "to": "no_show", "on": "no_show" },
      { "from": "checked_in", "to": "in_progress", "on": "start" },
      { "from": "in_progress", "to": "completed", "on": "complete" }
    ],
    "terminal": ["completed", "cancelled", "rejected", "no_show"]
  },
  "entryFlow": "main_menu",
  "fallbackFlow": "main_menu",
  "globalCommands": [
    { "keywords": ["menu", "hi", "hello", "start", "book", "القائمة", "مرحبا", "السلام عليكم", "حجز"], "flow": "main_menu" },
    { "keywords": ["bookings", "my bookings", "appointments", "حجوزاتي", "مواعيدي"], "flow": "my_bookings" },
    { "keywords": ["agent", "help", "موظف", "مساعدة"], "flow": "talk_to_us" },
    { "keywords": ["language", "lang", "اللغة", "لغة"], "flow": "language" },
    { "keywords": ["cancel", "stop", "إلغاء"], "flow": "main_menu" }
  ],
  "dashboardModules": ["calendar", "resources", "catalog", "customers", "inbox"],
  "settings": {
    "currency": "AED",
    "vatRate": 0.05,
    "vatInclusive": true,
    "paymentMethods": ["cash"],
    "slotStepMinutes": 30,
    "bufferMinutes": 10,
    "leadMinutes": 60,
    "maxAdvanceDays": 14
  }
}

# Server
PORT=3000
LOG_LEVEL=info

# Meta WhatsApp Cloud API (app level)
META_APP_SECRET=replace-me
META_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v23.0

# Outbound sender: "meta" sends through the Cloud API, "log" prints to stdout (no number needed)
WHATSAPP_SENDER=log

# Storage. REDIS_URL is optional; without it sessions and dedupe live in process memory.
DATABASE_URL=postgresql://ordr:ordr@localhost:5435/ordr?schema=public
REDIS_URL=redis://localhost:6379

# Seed data for `pnpm db:seed` (one tenant + one channel)
SEED_TENANT_NAME=Demo Restaurant
SEED_BLUEPRINT_ID=restaurant
SEED_PHONE_NUMBER_ID=000000000000000
SEED_WABA_ID=000000000000000
SEED_DISPLAY_PHONE=+971500000000
SEED_ACCESS_TOKEN=replace-me

# Claude assistant (optional). Leave empty to run the flows deterministically (guided mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voice notes: "none" sends the agent "[sent a voice note]" and it asks the customer to type.
# A speech-to-text adapter registers its name in apps/api/src/ai/transcriber.ts and reads TRANSCRIPTION_API_KEY.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=

# Server
PORT=3000
LOG_LEVEL=info

# Meta WhatsApp Cloud API (app level)
META_APP_SECRET=replace-me
META_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v23.0

# Outbound sender: "meta" sends through the Cloud API, "log" prints to stdout (no number needed)
WHATSAPP_SENDER=log

# Storage. REDIS_URL is optional; without it sessions and dedupe live in process memory.
DATABASE_URL=postgresql://ordr:ordr@localhost:5435/ordr?schema=public
REDIS_URL=redis://localhost:6379

# Seed data for `pnpm db:seed` (one tenant + one channel)
SEED_TENANT_NAME=Demo Restaurant
SEED_BLUEPRINT_ID=restaurant
SEED_PHONE_NUMBER_ID=000000000000000
SEED_WABA_ID=000000000000000
SEED_DISPLAY_PHONE=+971500000000
SEED_ACCESS_TOKEN=replace-me

# Claude assistant. Needed for the natural conversation style (web chat, salon, retail);
# without a key the guided WhatsApp flows still run and web chat falls back to a handoff.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Web chat and payment links point here (the dashboard dev server). Payments use the mock provider.
PUBLIC_BASE_URL=http://localhost:3001
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret
AUTH_SECRET=local-dev-auth-secret-change-me

# First dashboard login created by the seed
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Owner

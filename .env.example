# Server
PORT=3000
LOG_LEVEL=info

# Meta WhatsApp Cloud API (app level)
META_APP_SECRET=replace-me
META_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v23.0

# Outbound sender: "meta" sends through the Cloud API, "log" prints to stdout (no number needed)
WHATSAPP_SENDER=log

# Storage. REDIS_URL is optional; without it sessions and dedupe live in process memory.
DATABASE_URL=postgresql://ordr:ordr@localhost:5435/ordr?schema=public
REDIS_URL=redis://localhost:6379

# Seed data for `pnpm db:seed` (one tenant + one channel). Blueprints: restaurant, salon, retail,
# resort (four demo resorts with room types under one number).
SEED_TENANT_NAME=Demo Restaurant
SEED_BLUEPRINT_ID=restaurant
SEED_PHONE_NUMBER_ID=000000000000000
SEED_WABA_ID=000000000000000
SEED_DISPLAY_PHONE=+971500000000
SEED_ACCESS_TOKEN=replace-me

# Claude assistant (optional). Leave empty to run the flows deterministically (guided mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voice notes: "none" sends the agent "[sent a voice note]" and it asks the customer to type.
# Voice notes: "none" describes them to the agent (it asks the customer to type); "openai" transcribes them
# through OpenAI's speech-to-text endpoint with TRANSCRIPTION_API_KEY (an OpenAI API key).
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Push notifications to staff phones and browsers when the bot hands a chat to a person (optional).
# Generate a pair with `pnpm --filter @ordr/api push:keys`; push stays off while either key is empty.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@ordr.ae

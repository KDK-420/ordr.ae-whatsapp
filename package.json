{
  "name": "ordr-whatsapp",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@ordr/api",
    "dev:web": "pnpm --filter @ordr/dashboard dev",
    "dev:memory": "cd apps/api && STORAGE=memory tsx watch src/main.ts",
    "simulate": "pnpm --filter @ordr/api simulate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ordr/api prisma:migrate",
    "db:seed": "pnpm --filter @ordr/api prisma:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}

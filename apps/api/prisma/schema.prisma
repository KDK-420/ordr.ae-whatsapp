generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  blueprintId     String
  defaultLanguage String   @default("en")
  timezone        String   @default("Asia/Dubai")
  settings        Json     @default("{}")
  /// Last order number issued; incremented atomically when an order is created
  orderSeq        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channels      Channel[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]
  users         User[]
}

/// Merchant staff who sign in to the dashboard. Emails are unique across tenants.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  name         String
  passwordHash String
  /// owner or staff
  role         String    @default("staff")
  /// Platform operator: may create tenants and manage the number pool at /admin
  isPlatformAdmin Boolean @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pushSubscriptions PushSubscription[]

  @@index([tenantId])
}

model Channel {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String   @default("meta_cloud")
  phoneNumberId String   @unique
  wabaId        String
  displayPhone  String
  accessToken   String
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
}

/// WhatsApp numbers the platform owns and hands to tenants. Assigning one creates or moves the tenant's Channel.
model PhoneNumber {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique
  wabaId        String
  displayPhone  String
  accessToken   String
  /// Free text for operators, e.g. "SIM #3, du"
  label         String?
  /// Tenant currently using this number, null while in the pool
  tenantId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  waId      String
  name      String?
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@unique([tenantId, waId])
}

model Conversation {
  id            String    @id @default(cuid())
  tenantId      String
  channelId     String
  customerId    String
  /// bot: automated replies; human: an agent owns the thread; closed: archived
  status        String    @default("bot")
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  channel  Channel   @relation(fields: [channelId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([tenantId, customerId, status])
}

model Message {
  id                String   @id @default(cuid())
  tenantId          String
  conversationId    String
  /// in or out
  direction         String
  providerMessageId String?  @unique
  kind              String
  payload           Json
  status            String?
  createdAt         DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

/// Session snapshot used when Redis is not configured.
model Session {
  tenantId  String
  waId      String
  state     Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([tenantId, waId])
}

/// Webhook dedupe used when Redis is not configured.
model ProcessedWebhook {
  key        String   @id
  receivedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  /// Localized name, e.g. { "en": "Burgers", "ar": "برجر" }
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings Offering[]

  @@index([tenantId, sortOrder])
}

model Offering {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String?
  /// product or service
  type            String   @default("product")
  name            Json
  description     Json?
  /// Minor units (fils)
  priceMinor      Int
  currency        String   @default("AED")
  durationMinutes Int?
  imageUrl        String?
  /// Units on hand for products without variants; null means not tracked (always available)
  stock           Int?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category       Category?        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  @@index([tenantId, categoryId, sortOrder])
}

model ModifierGroup {
  id         String   @id @default(cuid())
  tenantId   String
  offeringId String
  name       Json
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  offering Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([offeringId, sortOrder])
}

model ModifierOption {
  id              String  @id @default(cuid())
  tenantId        String
  groupId         String
  name            Json
  priceDeltaMinor Int     @default(0)
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

/// Bookable staff, rooms or assets for service blueprints (salon, clinic).
model Resource {
  id        String   @id @default(cuid())
  tenantId  String
  /// staff | room | asset
  type      String   @default("staff")
  name      Json
  /// Weekly working hours: { "mon": [{ "start": "10:00", "end": "20:00" }], ... }; missing day = closed
  hours     Json     @default("{}")
  /// Offering ids this resource can serve; empty = all
  skills    Json     @default("[]")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String    @id @default(cuid())
  tenantId         String
  /// Per-tenant sequence shown to customers and kitchen
  number           Int
  /// order, booking or appointment
  kind             String    @default("order")
  status           String
  fulfillmentType  String
  source           String    @default("whatsapp")
  customerId       String
  conversationId   String?
  currency         String    @default("AED")
  subtotalMinor    Int
  deliveryFeeMinor Int       @default(0)
  vatMinor         Int       @default(0)
  totalMinor       Int
  paymentStatus    String    @default("unpaid")
  paymentMethod    String?
  deliveryLocation Json?
  notes            String?
  /// Bookings: start of the appointment, the resource it occupies and how long it takes
  scheduledAt      DateTime?
  resourceId       String?
  durationMinutes  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items         OrderItem[]
  events        OrderEvent[]
  paymentIntent PaymentIntent?

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, scheduledAt])
  @@index([resourceId, scheduledAt])
}

/// A purchasable variant of a product (size, weight, colour) with its own stock and optional price.
model ProductVariant {
  id         String   @id @default(cuid())
  tenantId   String
  offeringId String
  name       Json
  sku        String?
  /// Null inherits the offering price
  priceMinor Int?
  /// Null means not tracked
  stock      Int?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([tenantId, offeringId])
}

/// A customer's open shopping cart; items snapshot title and price, totals are recomputed at checkout.
model Cart {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  conversationId String?
  /// open | checked_out | expired
  status         String    @default("open")
  currency       String    @default("AED")
  items          Json      @default("[]")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, customerId, status])
}

/// Hosted-checkout intent for an order. The order is paid only when the provider's signed webhook says so.
model PaymentIntent {
  id          String    @id @default(cuid())
  tenantId    String
  orderId     String    @unique
  provider    String
  amountMinor Int
  currency    String
  /// pending | paid | failed | expired
  status      String    @default("pending")
  checkoutUrl String
  providerRef String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Provider webhook deliveries already processed, keyed by provider and event id, so replays are no-ops.
/// A dashboard user's browser or phone that asked for push notifications. One row per endpoint; dead endpoints are pruned on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  endpoint  String   @unique
  /// { p256dh, auth } as the browser handed them over
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WebhookReceipt {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())
}

/// A slot reserved for a customer while they confirm. Blocks other holds and bookings until it expires.
model BookingHold {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  conversationId String?
  offeringId     String
  resourceId     String
  startAt        DateTime
  endAt          DateTime
  /// held | confirmed | released | expired
  status         String   @default("held")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([tenantId, resourceId, status, startAt])
  @@index([tenantId, customerId, status])
}

/// Anonymous web chat session: a bearer token (hashed) bound to one customer and conversation.
model WebSession {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  conversationId String
  tokenHash      String   @unique
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([tenantId, customerId])
}

/// Whether a customer allowed this business to remember things about them, and on which message.
model CustomerConsent {
  customerId      String   @id
  tenantId        String
  memory          Boolean  @default(false)
  purpose         String   @default("personalization")
  sourceMessageId String?
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

/// Consented, evidence-backed facts about a customer, scoped to one tenant. Never a source of transactional truth.
model Memory {
  id               String    @id @default(cuid())
  tenantId         String
  customerId       String
  /// preference | fact
  kind             String
  key              String
  value            Json
  confidence       Float     @default(1)
  sourceMessageIds Json      @default("[]")
  consentPurpose   String    @default("personalization")
  createdAt        DateTime  @default(now())
  lastConfirmedAt  DateTime  @default(now())
  expiresAt        DateTime?
  deletedAt        DateTime?

  @@index([tenantId, customerId, deletedAt])
}

/// One model turn: which tools ran, tokens, timing and which memories were shown. The audit trail behind every reply.
model AgentRun {
  id               String   @id @default(cuid())
  tenantId         String
  conversationId   String
  inboundMessageId String?
  channel          String
  model            String
  tools            Json     @default("[]")
  memoryIds        Json     @default("[]")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  durationMs       Int      @default(0)
  /// replied | handoff | error | fallback
  outcome          String
  error            String?
  createdAt        DateTime @default(now())

  @@index([tenantId, conversationId, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  offeringId     String?
  variantId      String?
  variantTitle   String?
  title          String
  quantity       Int
  unitPriceMinor Int
  modifiers      Json    @default("[]")
  lineTotalMinor Int
  notes          String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offering Offering? @relation(fields: [offeringId], references: [id])

  @@index([orderId])
}

/// WhatsApp message templates per tenant, mirrored from Meta. Required for messages the
/// business starts outside the customer's 24 hour service window.
model MessageTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  /// Meta template name: lowercase letters, digits and underscores
  name           String
  /// Meta language code, e.g. en, ar
  language       String
  /// UTILITY | MARKETING | AUTHENTICATION
  category       String   @default("UTILITY")
  /// What the app uses it for, e.g. order_status
  purpose        String
  /// Body text as submitted, with {{1}}, {{2}} ... placeholders
  body           String
  /// Parameter names in placeholder order, e.g. ["orderNumber", "status", "total"]
  parameters     Json     @default("[]")
  /// draft | pending | approved | rejected | paused | disabled
  status         String   @default("draft")
  metaId         String?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, name, language])
  @@index([tenantId, purpose, status])
}

/// Transactional outbox: domain events written in the same transaction as the state change
/// and relayed to handlers by the worker (apps/api/src/worker.ts).
model OutboxEvent {
  id            String    @id
  tenantId      String
  type          String
  subjectKind   String
  subjectId     String
  payload       Json      @default("{}")
  occurredAt    DateTime
  /// pending | processing | sent | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([tenantId, occurredAt])
}

/// Append-only history of what happened to an order.
model OrderEvent {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

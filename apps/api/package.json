{
  "name": "@ordr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "simulate": "tsx src/cli/simulate.ts",
    "push:keys": "tsx src/cli/web-push-keys.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "clean": "rm -rf dist",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@ordr/blueprints": "workspace:*",
    "@ordr/domain": "workspace:*",
    "@ordr/flow-schema": "workspace:*",
    "@ordr/whatsapp": "workspace:*",
    "@prisma/client": "^6.16.0",
    "dotenv": "^17.0.0",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "web-push": "3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "3.6.4",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

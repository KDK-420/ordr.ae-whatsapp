# Production configuration. Copy to deploy/.env and fill in. bootstrap.sh does the copy and
# generates POSTGRES_PASSWORD, META_VERIFY_TOKEN, AUTH_SECRET and SEED_ADMIN_PASSWORD for you.

# Public hostname whose A record points at this server. Caddy requests a TLS certificate for it.
DOMAIN=app.ordr.ae

# Postgres password for the "ordr" database user. Hex only, so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=

# Meta WhatsApp Cloud API, app level. App secret: Meta app dashboard > App settings > Basic.
META_APP_SECRET=replace-me
# Any secret string; paste the same value into the webhook form in the Meta app dashboard.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# "meta" sends real messages through the Cloud API; "log" only prints them to the container log.
WHATSAPP_SENDER=meta
LOG_LEVEL=info

# Signs dashboard sessions. Changing it signs everyone out.
AUTH_SECRET=

# Claude assistant: understands free text, maps replies onto the options shown and drafts agent
# replies in the inbox. Leave empty to run the flows without AI. Key from console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voice notes: "openai" transcribes them with an OpenAI API key (the deploy workflow sets both when
# the TRANSCRIPTION_API_KEY or OPENAI_KEY secret exists); "none" makes the agent ask the customer to type.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Web chat and payment links: where customers reach the site (the deploy workflow sets it from DOMAIN).
PUBLIC_BASE_URL=https://app.ordr.ae
# Payments: "mock" ships a test checkout page that signs its own webhook. A real gateway goes
# behind the same port later. The secret signs webhooks; empty falls back to AUTH_SECRET.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
# Tenant slug behind the landing page's "Try the demo in web chat" button (empty hides it).
DEMO_CHAT_SLUG=demo-salon

# Public site: where "Book a demo" leads. A WhatsApp number in international digits, or leave
# empty to use the email address.
CONTACT_WHATSAPP=
CONTACT_EMAIL=hello@ordr.ae

# First dashboard login, created by `deploy.sh --seed`. Change the password after signing in
# (or set a new value here and reseed).
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Owner

# First tenant and WhatsApp number, loaded by `deploy.sh --seed`. From the Meta app dashboard,
# WhatsApp > API setup: phone number ID, WhatsApp Business Account ID, and a permanent system
# user access token with whatsapp_business_messaging permission.
SEED_TENANT_NAME="Demo Restaurant"
SEED_BLUEPRINT_ID=restaurant
SEED_PHONE_NUMBER_ID=000000000000000
SEED_WABA_ID=000000000000000
SEED_DISPLAY_PHONE=+971500000000
SEED_ACCESS_TOKEN=replace-me

# Push notifications to staff phones when the bot hands a chat to a person. Generate once with
# `pnpm --filter @ordr/api push:keys` (the deploy workflow sets them from the WEB_PUSH_PUBLIC_KEY and
# WEB_PUSH_PRIVATE_KEY secrets). Rotating the keys silently drops every registered device.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@ordr.ae

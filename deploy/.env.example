# Production configuration. Copy to deploy/.env and fill in. bootstrap.sh does the copy and
# generates POSTGRES_PASSWORD, META_VERIFY_TOKEN, AUTH_SECRET and SEED_ADMIN_PASSWORD for you.

# Public hostname whose A record points at this server. Caddy requests a TLS certificate for it.
DOMAIN=app.ordr.ae

# Postgres password for the "ordr" database user. Hex only, so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=

# Meta WhatsApp Cloud API, app level. App secret: Meta app dashboard > App settings > Basic.
META_APP_SECRET=replace-me
# Any secret string; paste the same value into the webhook form in the Meta app dashboard.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# "meta" sends real messages through the Cloud API; "log" only prints them to the container log.
WHATSAPP_SENDER=meta
LOG_LEVEL=info

# Signs dashboard sessions. Changing it signs everyone out.
AUTH_SECRET=

# First dashboard login, created by `deploy.sh --seed`. Change the password after signing in
# (or set a new value here and reseed).
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Owner

# First tenant and WhatsApp number, loaded by `deploy.sh --seed`. From the Meta app dashboard,
# WhatsApp > API setup: phone number ID, WhatsApp Business Account ID, and a permanent system
# user access token with whatsapp_business_messaging permission.
SEED_TENANT_NAME="Demo Restaurant"
SEED_BLUEPRINT_ID=restaurant
SEED_PHONE_NUMBER_ID=000000000000000
SEED_WABA_ID=000000000000000
SEED_DISPLAY_PHONE=+971500000000
SEED_ACCESS_TOKEN=replace-me
